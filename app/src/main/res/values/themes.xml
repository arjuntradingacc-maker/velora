<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Transient theme shown only for the duration of the system splash
         screen. All real theming (colors, typography, motion) lives in
         Compose — see core/design/Theme.kt. -->
    <style name="Theme.Velora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_velora_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Velora.Main</item>
    </style>

    <!-- Parented to a plain framework theme, not a Material Components style: Compose
         Material3 (androidx.compose.material3) ships no XML style resources at all — those
         only exist in the separate, unused com.google.android.material:material library.
         This theme is replaced by VeloraTheme (Compose) the instant setContent() runs, so a
         framework base is all it needs. -->
    <style name="Theme.Velora.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

</resources>
